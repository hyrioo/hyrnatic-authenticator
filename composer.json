{
    "name": "hyrioo/hyrnatic-authenticator",
    "description": "JWT authentication for Laravel with refresh tokens and type-safe scopes",
    "keywords": [
        "Hyrioo",
        "laravel",
        "hyrnatic-authenticator"
    ],
    "homepage": "https://github.com/hyrioo/hyrnatic-authenticator",
    "license": "MIT",
    "authors": [
        {
            "name": "Hyrioo",
            "email": "msp@hyrioo.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "lcobucci/clock": "^3.2",
        "lcobucci/jwt": "^5.2",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^8.22|^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4.6"
    },
    "autoload": {
        "psr-4": {
            "Hyrioo\\HyrnaticAuthenticator\\": "src/",
            "Hyrioo\\HyrnaticAuthenticator\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyrioo\\HyrnaticAuthenticator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "check": [
            "@validate-package",
            "@analyse",
            "@audit-dependencies",
            "@test"
        ],
        "audit-dependencies": "composer audit",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-text",
        "validate-package": "composer validate --strict --no-check-lock"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hyrioo\\HyrnaticAuthenticator\\HyrnaticAuthenticatorServiceProvider"
            ],
            "aliases": {
                "HyrnaticAuthenticator": "Hyrioo\\HyrnaticAuthenticator\\Facades\\HyrnaticAuthenticator"
            }
        }
    }
}
